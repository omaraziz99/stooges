# Copy to .env (git-ignored) and fill in. Environment variables override this file.

# --- Relay ---
# PORT=7777                      # Railway sets this automatically
# DB_PATH=stooges.db             # in production: /data/stooges.db on a volume
# ALLOWED_ORIGINS=https://your-app.vercel.app
# KPI_AGENT_PUBKEY=              # from `go run ./cmd/kpi -keygen` (public)
# MANAGER_PUBKEYS=               # hex public keys that may read everyone's KPI report; others see only their own

# --- KPI agent (cmd/kpi) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_API_KEY=             # only for -provider claude
KPI_AGENT_SECRET=                # from `go run ./cmd/kpi -keygen` (keep secret)
